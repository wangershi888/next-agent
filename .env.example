# 通义千问（阿里云 DashScope OpenAI 兼容接口）
# https://help.aliyun.com/zh/model-studio/developer-reference/use-qwen-by-api
DASHSCOPE_API_KEY=

# Tavily 联网搜索（LangChain Tavily 工具）
# https://docs.tavily.com/
TAVILY_API_KEY=

# LangSmith（观测 LangChain / LangGraph 调用链）
# https://smith.langchain.com/ 创建 API Key；复制到本地 .env.local（勿提交仓库）
# https://docs.langchain.com/langsmith/trace-with-langchain
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# 与 LANGCHAIN_API_KEY 等价（任选其一）
# LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=next-agent
# 可选：API 端点（默认美国区）
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 可选：默认模型名（见 frameworks/langchain/model/chat-models.ts）
# QWEN_MODEL=qwen-plus

# Deep Chat：官方 MCP（memory / sequential-thinking / host_filesystem），默认开启
# 关闭示例：DEEP_CHAT_MCP=0

# --- Puppeteer MCP（LangChain 对话里启用浏览器工具时）---
# 若报错「找不到浏览器」：在项目根执行一次（需联网下载 Chrome for Testing）
#   npm run puppeteer:install-browser
# 或指定本机 Chrome（MCP 使用 JSON 合并进 puppeteer.launch）：
# PUPPETEER_LAUNCH_OPTIONS={"executablePath":"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome","headless":true}
