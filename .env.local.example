# 复制本文件为 .env.local 后再填实际值。
# 申请 DeepSeek Key: https://platform.deepseek.com/

# ---------- 必填 ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 可选 · 模型与端点 ----------
# 默认模型（LangChain demo / LangGraph demo 都会读这个）
DEEPSEEK_MODEL=deepseek-v4-flash

# 用于 agentic 工作流（DeepAgent demo 默认读这个，要求支持 tool calling + 强推理）
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# 自建 / 代理端点时使用，留空则走 DeepSeek 官方默认
# DEEPSEEK_API_BASE=https://api.deepseek.com
